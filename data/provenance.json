        "findings": [
          {
            "id": "F-01",
            "severity": "blocking",
            "title": "Retry-After is truncated at 8 s — the spec names 30 s",
            "spec": "SPEC-RETRY-04 §4",
            "claim": "Retry-After of 30 s is honoured in full (SPEC §4 ceiling)",
            "detail": "Build A caps the server hint at 8 000 ms. A gateway asking for 30 s is retried after 8 s, three attempts inside 20 s, which is the load pattern the hint exists to prevent. The 5 s case passes, so A's own suite cannot see it.",
            "fix": "Honour the hint up to 30 000 ms, or change the spec — but not silently.",
            "evidence": {
              "run": "TESTS-B × BUILD-A",
              "case": "B5",
              "observed": "waited 30 s, not a truncated hint: expected 30000, got 8000",
              "counterpart": "pass"
            },
            "status": "open"
          },
          {
            "id": "F-02",
            "severity": "blocking",
            "title": "A POST without an idempotency key is retried with a fresh key",
            "spec": "SPEC-RETRY-04 §6",
            "claim": "A POST without a caller-supplied key is refused, not retried",
            "detail": "Build A invents a key when the caller supplies none, and generates a new one per attempt. A retry of a non-idempotent request can therefore write twice. §6 requires a refusal before the first attempt leaves the process.",
            "fix": "Refuse with a typed error before any I/O; never mint a key inside the retry loop.",
            "evidence": {
              "run": "TESTS-B × BUILD-A",
              "case": "B6",
              "observed": "throws before the first attempt: expected truthy, got null · error type: expected \"NonIdempotentRequest\", got null · no request was made: expected 0, got 1",
              "counterpart": "pass"
            },
            "status": "open"
          },
          {
            "id": "F-03",
            "severity": "accepted-divergence",
            "title": "504 is retried by B and not by A — the spec is silent",
            "spec": "SPEC-RETRY-04 §3",
            "claim": "504 is retried (spec silent — recorded as a divergence)",
            "detail": "A reads the retryable list as closed; B reads it as a minimum. Neither contradicts a normative sentence. Recorded as a divergence to be decided in the spec, not as a defect in a build.",
            "fix": "Name 504 in §3 either way. Until then the behaviour is recorded, not scored.",
            "evidence": {
              "run": "TESTS-B × BUILD-A",
              "case": "B8",
              "observed": "gateway timeout retried: expected 200, got 504",
              "counterpart": "pass"
            },
            "status": "accepted"
          }
        ],
        "notes": [
          {
            "id": "N-01",
            "title": "Both suites pass against the build that wrote them",
            "detail": "TESTS-A × BUILD-A: 4/4. TESTS-B × BUILD-B: 8/8. A suite written beside an implementation tests that implementation's reading, not the spec."
          },
          {
            "id": "N-02",
            "title": "The reviewer's suite is compatible with the builder's build",
            "detail": "TESTS-A × BUILD-B: 4/4. The divergence is not a rewrite; it is confined to the boundaries A never tested."
          },
          {
            "id": "N-03",
            "title": "Divergence is the signal",
            "detail": "3 of 8 reviewer cases fail against the builder's build. A single-agent review would have returned 4/4 and a green tick."
          }
        ],
